# ── Database ────────────────────────────────────────────────────────────────
# Supabase PostgreSQL — use the pooler URL (port 6543) for runtime queries
DATABASE_URL=
# Direct connection for prisma db push / migrations (port 5432)
DIRECT_URL=

# ── File storage ─────────────────────────────────────────────────────────────
# Vercel Blob — primary storage backend (uploads, documents, images).
# Create a Blob store in the Vercel dashboard, then paste its read/write token
# here (or run `vercel env pull` to fetch it). When set, all uploads go to Blob.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# ── AI (blog post generation) ────────────────────────────────────────────────
# Anthropic API key — required for the "Generate blog post" button.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── SmartBid (ConstructConnect) tender sync ──
# Fill these from your ConstructConnect / SmartBid API credentials.
SMARTBID_API_BASE=
SMARTBID_AUTH=apikey
SMARTBID_API_KEY=
# SMARTBID_AUTH_HEADER=Authorization
# SMARTBID_AUTH_SCHEME=Bearer 
# OAuth2 (only if SMARTBID_AUTH=oauth):
# SMARTBID_TOKEN_URL=
# SMARTBID_CLIENT_ID=
# SMARTBID_CLIENT_SECRET=
SMARTBID_PROJECTS_PATH=
# Pegah's SmartBid subcontractor-registration form (embedded on the page):
SMARTBID_SUBCONTRACTOR_FORM_URL=
