# ── Site ───────────────────────────────────────────────────────────────────
# Canonical public origin — used for SEO metadata, sitemap.xml, robots.txt and
# structured data. Set to the live domain in production.
NEXT_PUBLIC_SITE_URL=https://www.pegah.ca

# ── Database ────────────────────────────────────────────────────────────────
# Supabase PostgreSQL — use the pooler URL (port 6543) for runtime queries
DATABASE_URL=
# Direct connection for prisma db push / migrations (port 5432)
DIRECT_URL=

# ── File storage ─────────────────────────────────────────────────────────────
# Vercel Blob — primary storage backend (uploads, documents, images).
# Create a Blob store in the Vercel dashboard, then paste its read/write token
# here (or run `vercel env pull` to fetch it). When set, all uploads go to Blob.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# ── AI (blog post generation) ────────────────────────────────────────────────
# Anthropic API key — required for the "Generate blog post" button.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6
# Set to 1 to test the generate → edit → publish flow with canned drafts,
# WITHOUT calling Anthropic (no token cost). Leave blank/0 for real generation.
AI_MOCK=

# ── SmartBid (ConstructConnect) tender sync ──
# Fill these from your ConstructConnect / SmartBid API credentials.
SMARTBID_API_BASE=https://apicc.smartbidnet.com/
# ClientKey — the "key for the user client URL" (same Id as the subcontractor form URL).
SMARTBID_CLIENT_KEY=KdZrzmuXxS2nHQ
SMARTBID_PROJECTS_PATH=/project/publicProjects
# Which project statuses to pull (comma-separated). Default is live opportunities.
SMARTBID_STATUSES=OpenToBid,Upcoming
# Session token from a SmartBid login — only needed for account-protected endpoints, not public projects.
SMARTBID_PASSPORT_KEY=48FF1159B4858867E173237A91F7BFA5AEA95BA6
SMARTBID_TOKEN=MWVmOGRkYzVmM2U5NGYwZGIzYzgxMjE0N2ZjYjc4N2Q=
# Pegah's SmartBid subcontractor-registration form (embedded on the page):
SMARTBID_SUBCONTRACTOR_FORM_URL=https://securecc.smartbidnet.com/External/SubContractorRegistration.aspx?Id=KdZrzmuXxS2nHQ
